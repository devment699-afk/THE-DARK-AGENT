<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.darkagent.app.MatrixView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/splashLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THE DARK AGENT"
            android:textColor="#00FF66"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:shadowColor="#00FF66"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="22" />

        <View
            android:layout_width="200dp"
            android:layout_height="2dp"
            android:layout_marginTop="14dp"
            android:background="#00FF66" />

        <TextView
            android:id="@+id/splashTg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@telegram  @DARK_AGENT_OWNER"
            android:textColor="#9FE8A8"
            android:textSize="14sp"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="initializing engine..."
            android:textColor="#4d7a55"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
