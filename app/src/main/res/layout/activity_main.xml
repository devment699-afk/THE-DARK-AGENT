<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.darkagent.app.MatrixView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/mainTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="THE DARK AGENT"
                android:textColor="#00FF66"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:shadowColor="#00FF66"
                android:shadowRadius="18" />

            <TextView
                android:id="@+id/mainTg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:text="@DARK_AGENT_OWNER"
                android:textColor="#7ab88a"
                android:textSize="12sp" />

            <!-- DEVICE INFO CARD -->
            <LinearLayout
                android:id="@+id/cardDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp" />

            <!-- SYSTEM STATS CARD -->
            <LinearLayout
                android:id="@+id/cardSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp" />

            <!-- NETWORK CARD -->
            <LinearLayout
                android:id="@+id/cardNetwork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="20dp"
                android:text="— powered by @DARK_AGENT_OWNER —"
                android:textColor="#3d5c45"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
